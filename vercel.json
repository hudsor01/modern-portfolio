{
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/purge-contact-submissions",
      "schedule": "17 4 * * *"
    }
  ],
  "rewrites": [],
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  }
}
