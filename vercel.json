{
  "framework": "nextjs",
  "buildCommand": "bun run build",
  "devCommand": "bun run dev",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/github",
      "destination": "https://github.com/hudsor01"
    },
    {
      "source": "/linkedin",
      "destination": "https://linkedin.com/in/hudsor01"
    },
    {
      "source": "/twitter",
      "destination": "https://twitter.com/hudsor01"
    }
  ],
  "rewrites": [],
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  }
}
