{
  "name": "modern-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "next build",
    "build:ci": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format src",
    "format:fix": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "ci:quick": "bun run lint && bun run typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:chromium": "playwright test --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:serve": "test -d .next/standalone || { echo 'e2e:serve: .next/standalone is missing — run `bun run build` first (or use `bun run e2e:server`, which builds then serves).' >&2; exit 1; } && rm -rf .next/standalone/.next/static .next/standalone/public && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && node .next/standalone/server.js",
    "e2e:server": "bun run build && bun run e2e:serve",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run drizzle/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@sentry/nextjs": "11.10.0",
    "@tanstack/react-form": "1.33.5",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "marked": "18.1.2",
    "motion": "12.43.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nuqs": "2.10.2",
    "postcss": "8.5.32",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.6",
    "recharts": "3.10.1",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "1.4.4",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "^0.35.5",
    "esbuild": "^0.28.2"
  }
}
